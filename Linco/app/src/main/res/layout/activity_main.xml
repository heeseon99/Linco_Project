<?xml version="1.0" encoding="utf-8"?>
<!--App의 메인 화면 레이아웃-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <TextView
        android:paddingTop="45dp"
        android:paddingLeft="19dp"
        android:textSize="23dp"
        android:id="@+id/textEco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="환경"
        android:textColor="@color/menuBlue"
        tools:ignore="MissingConstraints">
    </TextView>
    <TextView
        android:id="@+id/text2"
        android:paddingTop="45dp"
        app:layout_constraintStart_toEndOf="@id/textEco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="을 지키는"
        android:textColor="@color/black"
        android:textSize="23dp"
        tools:ignore="MissingConstraints">
    </TextView>
    <TextView
        android:id="@+id/text3"
        android:paddingTop="3dp"
        app:layout_constraintTop_toBottomOf="@id/textEco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="정보를 알아보아요"
        android:paddingLeft="19dp"
        android:textColor="@color/black"
        android:textSize="23dp"
        tools:ignore="MissingConstraints"
        android:paddingBottom="23dp">
    </TextView>

    <ImageButton
        android:id="@+id/icon1"
        android:layout_width="280dp"
        android:padding="2dp"
        android:layout_height="270dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text3"
        android:src="@drawable/icon1"
        android:background="@color/white"
        android:scaleType="fitCenter"
        android:layout_margin="2dp"
        tools:ignore="MissingConstraints"></ImageButton>

    <ImageButton
        android:id="@+id/icon2"
        android:layout_marginTop="5dp"
        android:layout_width="280dp"
        android:padding="2dp"
        android:layout_margin="2dp"
        android:layout_height="270dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icon1"
        android:scaleType="fitCenter"
        android:background="@color/white"
        android:src="@drawable/icon2">
    </ImageButton>

</androidx.constraintlayout.widget.ConstraintLayout>